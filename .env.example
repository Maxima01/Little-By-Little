# Feature: Expo bundles these public values; never use a secret/service-role key here.
# Build validation rejects privileged keys; keep both unset to disable optional cloud saves.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Feature: optional browser bot protection; also enable Turnstile in Supabase Auth with its matching private secret.
# Only the PUBLIC site key belongs here. Restrict its allowed hostnames to the deployed website.
# Native/file-based desktop builds cannot render Turnstile; a protected provider requires browser sign-in.
# EXPO_PUBLIC_TURNSTILE_SITE_KEY=your_public_turnstile_site_key

# Feature: enable only with a reverse proxy that overwrites X-Novel-Client-IP on every request.
# HOST=127.0.0.1
# TRUSTED_PROXY_IP=127.0.0.1
